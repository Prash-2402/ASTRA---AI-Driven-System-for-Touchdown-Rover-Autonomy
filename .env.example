# ASTRA Environment Configuration
ASTRA_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Database (PostgreSQL or local SQLite for development)
DATABASE_URL=sqlite:///./database/astra.db
POSTGRES_USER=astra
POSTGRES_PASSWORD=astrasecret
POSTGRES_DB=astra_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Simulation Settings
SIMULATION_DT=0.02
TELEMETRY_RATE_HZ=20
RANDOM_SEED=42

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
