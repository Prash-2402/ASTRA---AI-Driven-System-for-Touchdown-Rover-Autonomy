<?xml version="1.0" ?>
<robot name="astra_rover">
  <!-- Rocker-Bogie 6-Wheel Autonomous Planetary Exploration Rover -->
  
  <!-- Main Chassis / Avionics Warm Electronics Box -->
  <link name="chassis">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="125.0"/>
      <inertia ixx="12.5" ixy="0.0" ixz="0.0" iyy="18.2" iyz="0.0" izz="24.8"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.4 0.9 0.45"/>
      </geometry>
      <material name="sage_chassis">
        <color rgba="0.467 0.580 0.467 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.4 0.9 0.45"/>
      </geometry>
    </collision>
  </link>

  <!-- Left Rocker Link -->
  <link name="rocker_left">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="1.2" iyz="0.0" izz="1.2"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.9 0.08 0.08"/>
      </geometry>
      <material name="metallic_dark">
        <color rgba="0.2 0.25 0.22 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.9 0.08 0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- Right Rocker Link -->
  <link name="rocker_right">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="1.2" iyz="0.0" izz="1.2"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.9 0.08 0.08"/>
      </geometry>
      <material name="metallic_dark">
        <color rgba="0.2 0.25 0.22 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.9 0.08 0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- Left Rocker Joint (Differential Pivot) -->
  <joint name="joint_rocker_left" type="revolute">
    <parent link="chassis"/>
    <child link="rocker_left"/>
    <origin xyz="0.0 0.55 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.45" upper="0.45" effort="100" velocity="1.0"/>
  </joint>

  <!-- Right Rocker Joint (Differential Pivot) -->
  <joint name="joint_rocker_right" type="revolute">
    <parent link="chassis"/>
    <child link="rocker_right"/>
    <origin xyz="0.0 -0.55 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.45" upper="0.45" effort="100" velocity="1.0"/>
  </joint>

  <!-- Left Bogie Link -->
  <link name="bogie_left">
    <inertial>
      <mass value="8.0"/>
      <inertia ixx="0.2" ixy="0" ixz="0" iyy="0.6" iyz="0" izz="0.6"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.65 0.06 0.06"/>
      </geometry>
      <material name="metallic_dark"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.65 0.06 0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- Right Bogie Link -->
  <link name="bogie_right">
    <inertial>
      <mass value="8.0"/>
      <inertia ixx="0.2" ixy="0" ixz="0" iyy="0.6" iyz="0" izz="0.6"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.65 0.06 0.06"/>
      </geometry>
      <material name="metallic_dark"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.65 0.06 0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- Left Bogie Joint -->
  <joint name="joint_bogie_left" type="revolute">
    <parent link="rocker_left"/>
    <child link="bogie_left"/>
    <origin xyz="0.4 0.08 -0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.5" effort="80" velocity="1.0"/>
  </joint>

  <!-- Right Bogie Joint -->
  <joint name="joint_bogie_right" type="revolute">
    <parent link="rocker_right"/>
    <child link="bogie_right"/>
    <origin xyz="0.4 -0.08 -0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.5" effort="80" velocity="1.0"/>
  </joint>

  <!-- 6 Actuated Wheels: Radius = 0.25m, Length = 0.20m -->
  <!-- 1. Front Left Wheel -->
  <link name="wheel_front_left">
    <inertial>
      <mass value="6.5"/>
      <inertia ixx="0.12" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.12"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.20"/>
      </geometry>
      <material name="wheel_metal">
        <color rgba="0.32 0.38 0.34 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.20"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_wheel_front_left" type="continuous">
    <parent link="bogie_left"/>
    <child link="wheel_front_left"/>
    <origin xyz="0.32 0.12 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 2. Mid Left Wheel -->
  <link name="wheel_mid_left">
    <inertial>
      <mass value="6.5"/>
      <inertia ixx="0.12" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.12"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.20"/>
      </geometry>
      <material name="wheel_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.20"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_wheel_mid_left" type="continuous">
    <parent link="bogie_left"/>
    <child link="wheel_mid_left"/>
    <origin xyz="-0.32 0.12 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 3. Rear Left Wheel -->
  <link name="wheel_rear_left">
    <inertial>
      <mass value="6.5"/>
      <inertia ixx="0.12" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.12"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.20"/>
      </geometry>
      <material name="wheel_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.20"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_wheel_rear_left" type="continuous">
    <parent link="rocker_left"/>
    <child link="wheel_rear_left"/>
    <origin xyz="-0.55 0.12 -0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 4. Front Right Wheel -->
  <link name="wheel_front_right">
    <inertial>
      <mass value="6.5"/>
      <inertia ixx="0.12" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.12"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.20"/>
      </geometry>
      <material name="wheel_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.20"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_wheel_front_right" type="continuous">
    <parent link="bogie_right"/>
    <child link="wheel_front_right"/>
    <origin xyz="0.32 -0.12 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 5. Mid Right Wheel -->
  <link name="wheel_mid_right">
    <inertial>
      <mass value="6.5"/>
      <inertia ixx="0.12" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.12"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.20"/>
      </geometry>
      <material name="wheel_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.20"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_wheel_mid_right" type="continuous">
    <parent link="bogie_right"/>
    <child link="wheel_mid_right"/>
    <origin xyz="-0.32 -0.12 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 6. Rear Right Wheel -->
  <link name="wheel_rear_right">
    <inertial>
      <mass value="6.5"/>
      <inertia ixx="0.12" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.12"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.20"/>
      </geometry>
      <material name="wheel_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.25" length="0.20"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_wheel_rear_right" type="continuous">
    <parent link="rocker_right"/>
    <child link="wheel_rear_right"/>
    <origin xyz="-0.55 -0.12 -0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
